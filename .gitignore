# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Secrets & local config (API keys live in core/.env)
.env
**/.env

# Large, regenerable data (Sharadar/FRED downloads + load logs)
core/data/

# IDE / OS / tooling
.idea/
.DS_Store
.claude/settings.local.json

# Logs
*.log
web/node_modules/
web/.next/
web/tsconfig.tsbuildinfo
# Real env files only — NOT web/.env.example, which is the documentation for them.
# The old rule was `web/.env*`, which silently ignored the example too, so the frontend
# flags were documented nowhere and a fresh clone had no way to discover them.
web/.env
web/.env.local
web/.env.*.local

.next/
# Local repo audit (never committed)
.audit/

# Agent guidance — local only, not part of the published project
CLAUDE.md
