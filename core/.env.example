# Copy to core/.env and adjust. core/.env is gitignored.

# --- Postgres (matches docker-compose.yml) ---
POSTGRES_USER=investing
POSTGRES_PASSWORD=investing
POSTGRES_DB=investing
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- FastAPI ---
API_HOST=127.0.0.1
API_PORT=8001

# --- Screen ---
# Which config/screens/<id>.yaml the idea board and backtests run by default.
# This is the main personalisation knob: copy the example, edit it, point this at yours.
ACTIVE_SCREEN=quality-value

# --- Nasdaq Data Link / Sharadar ---
# Get/rotate at https://data.nasdaq.com/account/profile
NASDAQ_DATA_LINK_API_KEY=

# --- FRED (St. Louis Fed) ---
# Get/rotate at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- SEC EDGAR ---
# REQUIRED for anything that reads filings. SEC blocks requests without a descriptive
# User-Agent carrying a real contact (403). Put your own name and e-mail here.
#   e.g. SEC_USER_AGENT="Jane Doe jane@example.com"
SEC_USER_AGENT=

# --- Setup/build control (local only; leave false on any public deployment) ---
SETUP_ENABLED=false
